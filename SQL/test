USE ROLE MDM_CUSTOMER_MATCHING_ROLE;
USE DATABASE MDM_CUSTOMER_MATCHING;
USE SCHEMA PUBLIC;

with MATCHES as (
SELECT 
       results.value:"@scores".cosine_similarity::FLOAT as cosine_search_similarity,
       results.value:customer_business_id::VARCHAR as match_customer_business_id,
       results.value:customer_full_detail::VARCHAR as ca_customer_full_detail,
       ca.customer_full_detail_embedding as ca_customer_full_detail_embedding,
       results.value:customer_name::VARCHAR as customer_name
FROM TABLE(
  FLATTEN(
    INPUT => PARSE_JSON(
      SNOWFLAKE.CORTEX.SEARCH_PREVIEW(
        'MDM_CUSTOMER_ADDRESS_SEARCH',
        '{
          "query": "Okmulgee High School, 415 W 3RD ST, OKMULGEE, US-OK, 74447-3205",
          "columns": ["customer_full_detail", "customer_business_id", "customer_name", "address_line_1", 
                      "address_line_2", "city", "county", "state", "postal_code", "postalcode_extension", "country"],
          "limit": 3
        }'
      )
    ),
    PATH => 'results'
  )
) as results inner join MDM_CUSTOMER_MATCHING.PUBLIC.CUSTOMER_ADDRESS CA
on results.value:customer_business_id::VARCHAR = CA.CUSTOMER_BUSINESS_ID
)
select 
MATCHES.*,
ci.customer_name,
ci.customer_full_detail,
editdistance(ci.customer_full_detail, MATCHES.ca_customer_full_detail) as edit_distance,
vector_cosine_similarity(ci.customer_full_detail_embedding, MATCHES.ca_customer_full_detail_embedding) as cosine_similarity
 from MATCHES
inner join MDM_CUSTOMER_MATCHING.PUBLIC.CUSTOMER_IDENTIFIER CI
on MATCHES.match_customer_business_id = ci.CUSTOMER_BUSINESS_ID;